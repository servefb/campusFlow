# CampusFlow AI Agent 服务环境变量模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，绝不会进版本库。

# ===== JWT =====
jwt_secret_key=

# ===== LLM 网关（兼容 OpenAI 协议）=====
# 网关地址与密钥由服务端配置提供；以下为可选覆盖项
DEFAULT_REASONING_EFFORT=none
# 思考强度枚举：none/minimal/low/medium/high/xhigh/max
MODEL_MAX_INPUT_TOKENS=1000000

# ===== Redis（缓存 / 流式会话）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://:<密码>@<主机>:6379/0

# ===== MySQL（Java 共库：campus_flow）=====
MYSQL_DATABASE_URL=mysql+aiomysql://<用户>:<密码>@<主机>:3306/campus_flow

# ===== Chroma（向量库）=====
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_SSL=false

# ===== MongoDB（Agent Store）=====
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# ===== RabbitMQ（与 Java 端协同，队列名必须与 Java 端一致）=====
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
RABBITMQ_HEARTBEAT=
RABBITMQ_BLOCKED_TIMEOUT=
RABBITMQ_RECONNECT_DELAY=
QUEUE_NAME=
CALLBACK_QUEUE=

# ===== MinIO（知识库文件）=====
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET_NAME=

# ===== RAG 切分 =====
# ⚠️ 单位是**字符**不是 token（RecursiveCharacterTextSplitter 默认 length_function=len）。
# 中文实测 token/字符 ≈ 1.145 —— 512 字符 ≈ 586 token。
CHUNK_SIZE=
CHUNK_OVERLAP=

# ===== RAG 检索 =====
# 一次取回多少块（默认 8）。块数 × 每块 token 才是进提示词的上下文量。
RETRIEVE_K=
# 相对闸：只保留距离在「最佳 × 该倍数」以内的块（默认 1.5）。
# 切狠了直接掉召回，收紧前先跑 _rag_recall_eval.py 看分布。
RETRIEVE_REL_THRESHOLD=
# 相对闸的保留下限（默认 3）：真库上 1.5 倍常把题裁到只剩 1 块，多段答案会缺依据。
RETRIEVE_MIN_KEEP=
# 跨分类检索：每个分类先各取几块，合并后再统一裁剪（默认 4）。
RETRIEVE_PER_KB=
# 分类数不超过这个值就全查（默认 8）；超过则用类心路由取前 RETRIEVE_TOP_CATEGORIES 个。
RETRIEVE_ROUTE_ALL_MAX=
RETRIEVE_TOP_CATEGORIES=
# 算类心时最多读多少块向量（超大集合只抽样估算，默认 2000）。
CENTROID_MAX_CHUNKS=
# 绝对闸：最佳距离超过它就判定「库外问题」，回「未检索到」（默认空 = 关闭）。
# 值从 `_rag_recall_eval.py` 的「top1 距离分布」一段取，两簇可分时它会直接给建议值。
RETRIEVE_MAX_DIST=
# 入库时单次请求送多少条文本给 embedding 接口（DashScope 上限 10）。
EMBED_BATCH_SIZE=

# ===== laya 输入护栏（本地 PyTorch 小模型）=====
LAYA_GUARD_MODEL_DIR=
LAYA_GUARD_THRESHOLD=
LAYA_GUARD_LOG_FILE=
LAYA_GUARD_LOG_PREVIEW=
# 文档护栏独立模型（与输入模型分开训练/部署）
LAYA_DOC_GUARD_MODEL_DIR=
LAYA_DOC_GUARD_THRESHOLD=
LAYA_DOC_GUARD_MODE=

# ===== OpenSandbox（会话级代码执行沙箱）=====
OPEN_SANDBOX_API_KEY=

# ===== 校园业务 API 工具 =====
CAMPUSFLOW_API_BASE=

# ===== OpenWiki（经验知识库，按用户隔离）=====
OPENWIKI_NPX=
OPENWIKI_USERS_BASE=
OPENWIKI_WIKI_DIR=

# ===== 对话历史窗口 =====
HISTORY_KEEP_ROUNDS=12
HISTORY_FOLD_ROUNDS=6

# ===== 软暂停看门狗 =====
PAUSE_FORCE_CANCEL_S=8

# ===== 附件落盘 =====
ATTACH_DEFAULT_DIR=
ATTACH_MAX_BYTES=
ATTACH_SUBDIR=
