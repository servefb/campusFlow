        <!-- 分布式任务调度执行器。扫描僵死补偿任务（FileScanRetryJob）的载体。
             版本由根 pom 的 ${xxl-job.version} 管理，当前 3.5.0 —— 与调度中心容器
             xuxueli/xxl-job-admin:3.5.0（192.168.150.100:8880）严格对齐。
             🔴 官方约束是「调度中心版本 ≥ 执行器版本」，执行器更高会注册不上
             （access token 校验失败或注册被直接拒绝），要升就两端一起升。
             入口类：com.xxl.job.core.handler.annotation.XxlJob / context.XxlJobHelper /
             executor.impl.XxlJobSpringExecutor（按 3.5.0 配置）。
             ⚠️ 2.5.0 只发布在 GitHub Packages，阿里镜像拉不到；2.3.x 与 3.x 中央仓库都有。 -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
