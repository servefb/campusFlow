# CampusFlow AI Agent 服务环境变量模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，绝不会进版本库。

# ===== JWT =====
jwt_secret_key=

# ===== LLM 网关（兼容 OpenAI 协议）=====
# 网关地址与密钥由服务端配置提供；以下为可选覆盖项
DEFAULT_REASONING_EFFORT=none
# 思考强度枚举：none/minimal/low/medium/high/xhigh/max
MODEL_MAX_INPUT_TOKENS=1000000

# ===== Redis（缓存 / 流式会话）=====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://:<密码>@<主机>:6379/0

# ===== MySQL（Java 共库：campus_flow）=====
MYSQL_DATABASE_URL=mysql+aiomysql://<用户>:<密码>@<主机>:3306/campus_flow

# ===== Chroma（向量库）=====
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_SSL=false

# ===== MongoDB（Agent Store）=====
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# ===== RabbitMQ（与 Java 端协同，队列名必须与 Java 端一致）=====
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
RABBITMQ_HEARTBEAT=
RABBITMQ_BLOCKED_TIMEOUT=
RABBITMQ_RECONNECT_DELAY=
QUEUE_NAME=
CALLBACK_QUEUE=

# ===== MinIO（知识库文件）=====
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_BUCKET_NAME=

# ===== RAG 切分 =====
CHUNK_SIZE=
CHUNK_OVERLAP=

# ===== laya 输入护栏（本地 PyTorch 小模型）=====
LAYA_GUARD_MODEL_DIR=
LAYA_GUARD_THRESHOLD=
LAYA_GUARD_LOG_FILE=
LAYA_GUARD_LOG_PREVIEW=
# 文档护栏独立模型（与输入模型分开训练/部署）
LAYA_DOC_GUARD_MODEL_DIR=
LAYA_DOC_GUARD_THRESHOLD=
LAYA_DOC_GUARD_MODE=

# ===== OpenSandbox（会话级代码执行沙箱）=====
OPEN_SANDBOX_API_KEY=

# ===== 校园业务 API 工具 =====
CAMPUSFLOW_API_BASE=

# ===== OpenWiki（经验知识库，按用户隔离）=====
OPENWIKI_NPX=
OPENWIKI_USERS_BASE=
OPENWIKI_WIKI_DIR=

# ===== 对话历史窗口 =====
HISTORY_KEEP_ROUNDS=12
HISTORY_FOLD_ROUNDS=6

# ===== 软暂停看门狗 =====
PAUSE_FORCE_CANCEL_S=8

# ===== 附件落盘 =====
ATTACH_DEFAULT_DIR=
ATTACH_MAX_BYTES=
ATTACH_SUBDIR=
