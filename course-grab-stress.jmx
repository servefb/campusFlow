          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="选课请求头" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${accessToken}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Idempotency-Token</stringProp>
                <stringProp name="Header.value">${enrollToken}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <SyncTimer guiclass="TestBeanGUI" testclass="SyncTimer" testname="同步定时器（等所有学生到齐后同时选课）" enabled="true">
            <stringProp name="groupSize">${threads}</stringProp>
            <longProp name="timeoutInMs">60000</longProp>
          </SyncTimer>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="统计成功次数" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def body = prev.getResponseDataAsString()
def ok = false
try {
  ok = new groovy.json.JsonSlurper().parseText(body).code == 0
} catch (Exception e) {
  ok = false
}
if (ok) {
  synchronized (props) {
    props.put(&quot;grabOk&quot;, (props.get(&quot;grabOk&quot;) ?: 0) + 1)
  }
}
log.info(&quot;GRAB account=&quot; + vars.get(&quot;account&quot;) + &quot; http=&quot; + prev.getResponseCode() + &quot; ok=&quot; + ok + &quot; body=&quot; + body)</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="校验：不超卖、成功次数与人数增量一致" enabled="true">
