<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="多人抢课压测">
      <stringProp name="TestPlan.comments">多个学生各自登录、各自申请 token，同一时刻抢同一个开课班。SetupThreadGroup 记录抢课前人数 -&gt; 抢课组 N 个线程（每线程一个学生，SyncTimer 等齐后同时选课）-&gt; PostThreadGroup 校验不超卖、成功次数与人数增量一致。</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
        <collectionProp name="Arguments.arguments">
          <elementProp name="offeringId" elementType="Argument">
            <stringProp name="Argument.name">offeringId</stringProp>
            <stringProp name="Argument.value">509</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="threads" elementType="Argument">
            <stringProp name="Argument.name">threads</stringProp>
            <stringProp name="Argument.value">500</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="studentsFile" elementType="Argument">
            <stringProp name="Argument.name">studentsFile</stringProp>
            <stringProp name="Argument.value">D:\worker-space\WebstormProjects\campusflow\course-grab-students.csv</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="checkAccount" elementType="Argument">
            <stringProp name="Argument.name">checkAccount</stringProp>
            <stringProp name="Argument.value">2022010834</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="checkPassword" elementType="Argument">
            <stringProp name="Argument.name">checkPassword</stringProp>
            <stringProp name="Argument.value">0706</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="courseId" elementType="Argument">
            <stringProp name="Argument.name">courseId</stringProp>
            <stringProp name="Argument.value">101</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="termCode" elementType="Argument">
            <stringProp name="Argument.name">termCode</stringProp>
            <stringProp name="Argument.value">2026Fall</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
    </TestPlan>
